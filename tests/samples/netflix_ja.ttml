<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    ttp:tickRate="10000000" ttp:timeBase="media" xml:lang="ja"
    ttp:frameRate="24" ttp:frameRateMultiplier="1000 1001"
    tts:extent="1920px 1080px">
  <head>
    <styling>
      <initial tts:color="white" tts:fontSize="100%" tts:fontStyle="normal" tts:fontWeight="normal"/>
      <style xml:id="style0" tts:fontFamily="Japanese" tts:fontSize="100%" tts:shear="16.666666%"/>
      <style xml:id="style1" tts:fontFamily="Japanese" tts:fontSize="100%"/>
      <style xml:id="style2" tts:fontFamily="Japanese" tts:fontSize="50%" tts:ruby="textContainer"/>
      <style xml:id="bouten" tts:textEmphasis="filled dot before" tts:color="yellow"/>
    </styling>
    <layout>
      <region xml:id="region0" tts:displayAlign="after" tts:extent="80% 20%" tts:origin="10% 70%"/>
      <region xml:id="region1" tts:displayAlign="before" tts:extent="80% 20%" tts:origin="10% 10%"/>
      <region xml:id="region2" tts:writingMode="tbrl" tts:displayAlign="before" tts:extent="20% 80%" tts:origin="75% 10%"/>
    </layout>
  </head>
  <body>
    <div xml:space="default">
      <p xml:id="s1" begin="12345678t" end="45678901t" region="region0" style="style1">これは<span style="style0">テスト</span>です</p>
      <p xml:id="s2" begin="00:00:05.005" end="00:00:08.008" region="region0" style="style1"><span tts:ruby="container"><span tts:ruby="base">東京</span><span tts:ruby="text">とうきょう</span></span>へ行く</p>
      <p xml:id="s3" begin="00:00:06.000" end="00:00:09.500" region="region1" style="style0">上に表示される字幕<br/>二行目です</p>
      <p xml:id="s4" begin="00:00:10.000" end="00:00:13.000" region="region2" style="style1">縦書きの<span tts:ruby="container"><span tts:ruby="base">字幕</span><span tts:ruby="text">じまく</span></span>テスト２０２４</p>
      <p xml:id="s5" begin="00:00:14.000" end="00:00:16.000" region="region0" style="style1"><span style="bouten">強調</span>された言葉</p>
    </div>
  </body>
</tt>
